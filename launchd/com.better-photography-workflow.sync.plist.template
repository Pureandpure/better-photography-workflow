<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.better-photography-workflow.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BPW_CLI__</string>
        <string>sync</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BPW_INSTALL_ROOT</key>
        <string>__BPW_ROOT__</string>
        <key>BPW_CONFIG_FILE</key>
        <string>__CONFIG_FILE__</string>
        <key>BPW_STATE_DIR</key>
        <string>__STATE_DIR__</string>
        <key>BPW_LOG_DIR</key>
        <string>__LOG_DIR__</string>
        <key>BPW_MAIN_LOG</key>
        <string>__MAIN_LOG__</string>
    </dict>
    <key>StartInterval</key>
    <integer>__INTERVAL__</integer>
