#!/bin/zsh
set -u

SCRIPT_DIR="${0:A:h}"
if [[ -n "${BPW_ROOT:-}" ]]; then
  APP_ROOT="$BPW_ROOT"
elif [[ -f "${SCRIPT_DIR:h}/lib/common.sh" ]]; then
  APP_ROOT="${SCRIPT_DIR:h}"
else
  APP_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/better-photography-workflow"
fi
[[ -f "$APP_ROOT/lib/common.sh" ]] || { print -u2 -- "bpw: 找不到安装文件：$APP_ROOT"; exit 1; }
BPW_ROOT="$APP_ROOT"
export BPW_ROOT
source "$BPW_ROOT/lib/common.sh" || exit 1

usage() {
  cat <<'EOF'
better-photography-workflow (bpw)

用法：bpw <command> [参数]

命令：
  install             安装或更新程序与 launchd 服务
  uninstall [--purge] 卸载程序；--purge 同时删除配置、状态和日志
  init                创建默认配置与摄影工作目录（不覆盖配置）
  new "项目名称" [--workspace id]  按 Workspace 策略创建项目与提醒
  workspace list / add <id> <路径> --type local|external [--name 名称]
  workspace preference auto|local|ask
  project list / show <id>
  media list          检测媒体卡（JSON）
  imports [--project id] 最近成功导入（JSON）
  ingest [来源路径] [--project id|--new 名称] [--workspace id]
         [--device A7R5|Pocket3|Action6|Air3S|Unknown] [--dates yyyy-MM-dd[,yyyy-MM-dd]] [--dry-run] [--checksum]
  cancel-ingest       请求当前导入安全停止
  scan                扫描一级项目目录并处理新项目
  sync [--project id]  备份 online Primary 项目到已挂载硬盘
  status              显示配置、项目、备份与后台任务状态
  projects list       以 JSON 列出真实项目与持久化工作流状态
  projects set-stage <项目路径> <阶段>
                      更新项目阶段：ingest/verify/organize/edit/export/archive/done
  projects set-favorite <项目路径> <true|false>
                      更新项目收藏状态
  doctor              检查运行环境、权限、配置和服务
  logs                显示主日志最近 100 行
  app                 打开图形界面
  version             显示版本
  config export       以 JSON 输出当前有效配置
  config apply <文件> 校验并保存 plist 或 JSON 配置
  config path         显示图形界面配置文件路径
  help                显示本帮助
EOF
}

command_init() {
  bpw_set_runtime_paths
  if [[ -e "$BPW_CONFIG_FILE" ]]; then
    print -r -- "配置文件已存在，不会覆盖：$BPW_CONFIG_FILE"
  else
    mkdir -p "${BPW_CONFIG_FILE:h}" || exit 1
    cp "$BPW_ROOT/config/config.example" "$BPW_CONFIG_FILE" || exit 1
    chmod 600 "$BPW_CONFIG_FILE" || exit 1
    print -r -- "已创建配置文件：$BPW_CONFIG_FILE"
  fi
  bpw_load_config || exit 1
  bpw_work_dir_mount_safe || exit 1
  mkdir -p "$WORK_DIR" || { bpw_error "无法创建工作目录：$WORK_DIR"; exit 1; }
  bpw_prepare_runtime_dirs || exit 1
  print -r -- "已准备摄影工作目录：$WORK_DIR"
  print -r -- "下一步：编辑配置后运行 bpw doctor；安装后台任务请运行 bpw install。"
}

command_new() {
  local project_path
  project_path="$("$BPW_ROOT/scripts/workflow-engine.sh" new "$@")" || return $?
  print -r -- "已创建项目：$project_path"
  "$BPW_ROOT/scripts/scan-projects.sh" --project "$project_path"

}

command_status() {
  bpw_load_config || exit 1
  bpw_prepare_runtime_dirs || exit 1
  local discovered=0 processed=0 pending=0 project_path mounted="否" watch="未加载" sync="未加载"
  local paths_file
  paths_file="$(mktemp "${TMPDIR:-/tmp}/bpw-status-paths.XXXXXX")" || return 1
  "$BPW_ROOT/scripts/workflow-engine.sh" paths > "$paths_file" || { rm -f "$paths_file"; return 1; }
  while IFS= read -r -d '' project_path; do
    discovered=$((discovered + 1))
    if bpw_project_is_processed "$project_path"; then processed=$((processed + 1)); fi
  done < "$paths_file"
  rm -f "$paths_file"
  pending=$((discovered - processed))
  bpw_volume_is_mounted && mounted="是"
  bpw_launchd_loaded "$BPW_WATCH_LABEL" && watch="已加载"
  bpw_launchd_loaded "$BPW_SYNC_LABEL" && sync="已加载"
  print -r -- "配置文件：$BPW_CONFIG_FILE"
  print -r -- "工作目录：$WORK_DIR"
  print -r -- "工作目录存在：$([[ -d "$WORK_DIR" ]] && print 是 || print 否)"
  print -r -- "已发现项目：$discovered"
  print -r -- "已处理项目：$processed"
  print -r -- "未处理项目：$pending"
  print -r -- "提醒事项列表：$REMINDER_LIST_NAME"
  print -r -- "备份已启用：$([[ "$ENABLE_BACKUP" == true ]] && print 是 || print 否)"
  print -r -- "外接硬盘已连接：$mounted"
  print -r -- "扫描服务：$watch"
  print -r -- "备份服务：$sync"
  print -r -- "最近导入：$(bpw_operation_status_summary ingest)"
  "$BPW_ROOT/scripts/workflow-engine.sh" workspace list || return 1
  print -r -- "最近扫描：$(bpw_operation_status_summary scan)"
  print -r -- "最近同步：$(bpw_operation_status_summary sync)"
  print -r -- "最近成功同步：$(bpw_last_success_timestamp sync)"
}

command_logs() {
  bpw_set_runtime_paths
  if [[ -f "$BPW_MAIN_LOG" ]]; then
    tail -n 100 "$BPW_MAIN_LOG"
  else
    print -r -- "尚无日志：$BPW_MAIN_LOG"
  fi
}

command_app() {
  (( $# == 0 )) || { bpw_error "bpw app 不接受参数"; return 2; }
  local app_bundle="${BPW_APP_BUNDLE:-$HOME/Applications/摄影工作流.app}"
  [[ -d "$app_bundle" ]] || {
    bpw_error "找不到图形界面：$app_bundle"
    print -u2 -- "请先运行：./app/build-app.sh，然后将“摄影工作流.app”放到 ~/Applications。"
    return 1
  }
  open "$app_bundle" || { bpw_error "无法打开图形界面：$app_bundle"; return 1; }
  print -r -- "已打开图形界面：$app_bundle"
}

command_config() {
  local action="${1:-}"
  (( $# > 0 )) && shift
  case "$action" in
    export)
      (( $# == 0 )) || { bpw_error "用法：bpw config export"; return 2; }
      bpw_emit_effective_config_json
      ;;
    apply)
      (( $# == 1 )) || { bpw_error "用法：bpw config apply <plist-or-json>"; return 2; }
      bpw_apply_plist_config "${1:A}"
      ;;
    path)
      (( $# == 0 )) || { bpw_error "用法：bpw config path"; return 2; }
      print -r -- "$BPW_PLIST_CONFIG_FILE"
      ;;
    *)
      bpw_error "用法：bpw config <export|apply|path>"
      return 2
      ;;
  esac
}

command_name="${1:-help}"
(( $# > 0 )) && shift
case "$command_name" in
  install) "$BPW_ROOT/install.sh" "$@" ;;
  uninstall) "$BPW_ROOT/uninstall.sh" "$@" ;;
  init) command_init "$@" ;;
  new) command_new "$@" ;;
  scan) (( $# == 0 )) || { bpw_error "bpw scan 不接受参数"; exit 2; }; "$BPW_ROOT/scripts/scan-projects.sh" ;;
  sync) "$BPW_ROOT/scripts/sync-projects.sh" "$@" ;;
  status) (( $# == 0 )) || { bpw_error "bpw status 不接受参数"; exit 2; }; command_status ;;
  projects|project) "$BPW_ROOT/scripts/workflow-engine.sh" "$command_name" "$@" ;;
  workspace|media|ingest|imports|cancel-ingest) "$BPW_ROOT/scripts/workflow-engine.sh" "$command_name" "$@" ;;
  doctor) (( $# == 0 )) || { bpw_error "bpw doctor 不接受参数"; exit 2; }; BPW_CLI_PATH="${0:A}" "$BPW_ROOT/scripts/doctor.sh" ;;
  logs) (( $# == 0 )) || { bpw_error "bpw logs 不接受参数"; exit 2; }; command_logs ;;
  app) command_app "$@" ;;
  version) (( $# == 0 )) || { bpw_error "bpw version 不接受参数"; exit 2; }; print -r -- "bpw $BPW_VERSION" ;;
  config) command_config "$@" ;;
  help|-h|--help) usage ;;
  *) bpw_error "未知命令：$command_name"; usage >&2; exit 2 ;;
esac
